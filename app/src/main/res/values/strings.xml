    <string name="title_shizuku_setup_steps">Shizuku Setup Steps:</string>
    <string name="desc_shizuku_setup_steps">1. Settings &gt; About Phone &gt; Software Info\n   &gt; Tap Build Number 7 times\n2. Settings &gt; Developer Options\n   &gt; Wireless Debugging &gt; ON\n3. Open Shizuku &gt; \"Start via Wireless Debugging\"</string>
